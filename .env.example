# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en komt nooit in Git.

# Verbinden met Jira (stap B2). OAuth 2.0 (3LO)-app in de Atlassian developer
# console, scope read:jira-work, callback-URL http://localhost:3000/api/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Teamleader Orbit, officiële connector (fase 0 en 3)
# Client-id van de app-registratie bij Orbit. Geen geheim, wel per installatie.
ORBIT_CLIENT_ID=

# Inloggen met Google (stap B1). OAuth-client van het type "Web application"
# met redirect-URI http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sleutel om tokens versleuteld op te slaan: 32 willekeurige bytes, base64.
# Maak er een met: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Accountgegevens in Superhuman. API-token van één persoon, beperkt tot de
# tabel op de pagina Shortcuts in Culture Rotterdam Mission Control (lezen en
# schrijven). Aanmaken op https://docs.superhuman.com/account onder API settings.
SUPERHUMAN_API_TOKEN=
